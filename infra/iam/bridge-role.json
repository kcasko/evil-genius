{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOneAgentCoreRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "${AGENT_RUNTIME_ARN}"
    },
    {
      "Sid": "InvokeNovaLiteThroughApprovedProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1:${AWS_ACCOUNT_ID}:inference-profile/us.amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/amazon.nova-lite-v1:0"
      ]
    },
    {
      "Sid": "RateLimitAndKillSwitchTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "${RATELIMIT_TABLE_ARN}"
    },
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:${AWS_ACCOUNT_ID}:log-group:/aws/lambda/${BRIDGE_FUNCTION_NAME}:*"
    }
  ]
}
